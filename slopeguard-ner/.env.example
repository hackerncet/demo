DEMO_MODE=true
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@slopeguard.app
ADMIN_PASSWORD=replace-with-a-unique-password
# Set a managed PostgreSQL connection URL for durable records.
# DATABASE_URL=postgresql://user:password@host:5432/database
# SQLite is the local-development fallback, not durable on free Render.
SQLITE_PATH=slopeguard.db
